<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{subject}}</title>
</head>
<!-- Campaign email, "Plain" style: no banner or styled card, so it reads like
     a personal email (Gmail weighs that when choosing Primary vs Promotions).
     Still carries the branch address and unsubscribe link. bodyHtml is
     escaped and formatted by src/lib/messageFormat.js. -->
<body style="margin:0;padding:24px 16px;background-color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#222222;">
  <div style="max-width:560px;">
    {{{bodyHtml}}}
    <p style="margin:24px 0 0;">{{senderName}}<br>TrybeMarket</p>
    <p style="margin:36px 0 0;font-size:12px;line-height:1.5;color:#888888;">
      {{#if address}}{{branchName}} · {{address}}<br>{{/if}}
      You're getting this because you have a TrybeMarket account{{#if school}} at {{school}}{{/if}}.
      <a href="{{unsubscribeUrl}}" style="color:#888888;text-decoration:underline;">Unsubscribe</a>
    </p>
  </div>
</body>
</html>
