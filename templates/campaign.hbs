<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{subject}}</title>
</head>
<!-- Campaign email (08-campaign-messaging.md §5.2). Inline styles only:
     many email apps strip <style> blocks. bodyHtml is already escaped and
     formatted by src/lib/messageFormat.js. -->
<body style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:20px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background-color:#ffffff;border-radius:10px;overflow:hidden;">
          <tr>
            <td align="center" style="background-color:#4c7bfc;padding:24px;">
              <img src="https://www.trybemarket.online/assets/logo.png" alt="TrybeMarket" width="150" style="display:block;width:150px;height:auto;border:0;">
            </td>
          </tr>
          <tr>
            <td style="padding:28px 28px 8px;font-size:15px;line-height:1.6;color:#333333;">
              {{{bodyHtml}}}
              <p style="margin:24px 0 0;">The TrybeMarket Team</p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 28px 28px;border-top:1px solid #eeeeee;font-size:12px;line-height:1.6;color:#777777;">
              {{#if branchName}}<p style="margin:0;"><strong>{{branchName}}</strong></p>{{/if}}
              {{#if address}}<p style="margin:0;">{{address}}</p>{{/if}}
              {{#if supportLine}}<p style="margin:0;">{{supportLine}}</p>{{/if}}
              <p style="margin:12px 0 0;">
                You're getting this because you have a TrybeMarket account{{#if school}} at {{school}}{{/if}}.
                <a href="{{unsubscribeUrl}}" style="color:#777777;text-decoration:underline;">Unsubscribe from offers and updates</a>.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
