# Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK Configuration (Private - Server-side only)
# ⚠️ NEVER commit this file or share these keys publicly
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_admin_client_email
FIREBASE_PRIVATE_KEY=your_admin_private_key

# TrybeMarket web app (the app end users use) — public base URL, no trailing slash.
# The CRSA page calls the web app's CRSA API through this app's /api/crsa/* relay
# and builds ambassadors' referral links from it. Use http://localhost:3000 when
# running the web app locally.
NEXT_PUBLIC_WEB_APP_URL=https://your-web-app-domain

# Optional: only if the web app's Vercel project has Deployment Protection enabled and
# NEXT_PUBLIC_WEB_APP_URL can't point at an unprotected production domain. Generate it
# in the web app's Vercel project: Settings -> Deployment Protection ->
# Protection Bypass for Automation. Server-side only — never prefix with NEXT_PUBLIC_.
WEB_APP_PROTECTION_BYPASS_SECRET=
